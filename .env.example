# Copy to .env and use your own infrastructure. Never commit .env.
APP_ENV=development
SESSION_COOKIE_SECURE=false
API_ADDR=:8080
WEB_ORIGIN=http://localhost:3000
API_PROXY_TARGET=http://127.0.0.1:8080
NEXT_PUBLIC_DEVELOPMENT_USER_ID=0198b8a0-0001-7000-8000-000000000002
AUTH_SESSION_DIGEST_KEY=
AUTH_RECOVERY_PEPPER=
# Matches deploy/compose/compose.yaml; development only.
MYSQL_DSN=novelstudio:novelstudio@tcp(127.0.0.1:3306)/novelstudio?parseTime=true&loc=UTC&time_zone=%27%2B00%3A00%27
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
RABBITMQ_URL=amqp://novelstudio:novelstudio@127.0.0.1:5672/
TURNSTILE_DEV_TOKEN=dev-token
NEXT_PUBLIC_TURNSTILE_DEV_TOKEN=dev-token
REGISTRATION_INITIAL_LIGHT=20
SMTP_ADDR=
# Provision your own external S3-compatible MinIO server. Loopback is rejected.
MINIO_ENDPOINT=
MINIO_PUBLIC_URL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=novelstudio
MODEL_PROVIDER=fake
MODERATION_PROVIDER=synthetic
TEST_MODEL_BASE_URL=
TEST_MODEL_API_KEY=
TEST_MODEL_NAME=
COVER_BASE_URL=
COVER_API_KEY=
COVER_MODEL=
